{
    "name": "panic-on-rails",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "packageManager": "pnpm@11.1.1",
    "engines": {
        "node": ">=24.0.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "tsc -b",
        "preview": "vite preview",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test --project=chromium",
        "e2e:dev": "PLAYWRIGHT_DEV=1 playwright test --project=dev",
        "e2e:headed": "playwright test --headed",
        "e2e:ui": "playwright test --ui",
        "e2e:report": "playwright show-report e2e-report"
    },
    "dependencies": {
        "file-saver": "^2.0.5",
        "immer": "^11.1.18",
        "konva": "^10.7.0",
        "lucide-react": "^1.48.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-konva": "^19.3.0",
        "uuid": "^14.0.2",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@fast-check/vitest": "^0.5.0",
        "@playwright/test": "^1.63.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "fast-check": "^4.10.2",
        "globals": "^17.12.0",
        "jsdom": "^29.0.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.1",
        "vitest": "^4.1.10"
    }
}
